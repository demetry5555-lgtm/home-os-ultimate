# Copy to .env and fill with your Supabase project values.
# Supabase now issues "publishable" keys (sb_publishable_...) instead of the
# old JWT anon key - both work as VITE_SUPABASE_ANON_KEY with supabase-js v2.87+.
# NEVER use the service_role (secret) key here.
# App runs in local demo mode when these are absent.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY
